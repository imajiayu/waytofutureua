# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WayForPay (Ukrainian Payment Provider)
WAYFORPAY_MERCHANT_ACCOUNT=your_merchant_account
WAYFORPAY_SECRET_KEY=your_secret_key

# EPay 易支付 (微信支付 / 支付宝，面向海外华人用户)
# 一套被多家服务商各自部署的协议——换服务商只需改 EPAY_PROVIDER + 密钥，
# 可选值见 lib/payment/epay/providers.ts 的 EPAY_PROVIDERS
EPAY_PROVIDER=Ezfp
EPAY_PID=your_merchant_id
# 商户私钥与平台公钥：在服务商后台「个人信息 → API 设置」生成/获取
# 裸 Base64 或完整 PEM 均可，代码会自动补 PEM 头
EPAY_MERCHANT_PRIVATE_KEY=your_merchant_private_key
EPAY_PLATFORM_PUBLIC_KEY=platform_public_key
NEXT_PUBLIC_EPAY_USD_CNY_RATE=7.2

# Resend (Email)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@send.waytofutureua.org.ua

# App
# 本地开发请显式设置为 http://localhost:3000；
# 未设置时代码 fallback 为生产域名 https://waytofutureua.org.ua
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (Error Monitoring)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Cloudinary (Image Processing)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
